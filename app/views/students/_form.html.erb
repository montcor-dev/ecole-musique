<%= form_with model: student do |form| %>
    <div>
        <%= form.label :prenom %>
        <%= form.text_field :prenom %>
    </div>

    <div>
        <%= form.label :nom %>
        <%= form.text_field :nom %>
    </div>

        <div>
        <%= form.label :email %>
        <%= form.text_field :email %>
    </div>

    <div>
        <%= form.submit %>
    </div>
<%end%>