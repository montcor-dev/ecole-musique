<%= form_with model: student do |form| %>

    <!-- Person fields -->
    <%= form.fields_for :person do |person_fields| %>
      <div>
        <%= person_fields.label :titre %>
        <%= person_fields.text_field :titre %>
      </div>

      <div>
        <%= person_fields.label :formule %>
        <%= person_fields.text_field :formule %>
      </div>

      <div>
        <%= person_fields.label :tutoiement, "Tutoiement (coché = tu, décoché = vous) " %>
        <%= person_fields.check_box :tutoiement %>
      </div>

      <div>
        <%= person_fields.label :prenom %>
        <%= person_fields.text_field :prenom %>
      </div>

      <div>
        <%= person_fields.label :nom %>
        <%= person_fields.text_field :nom %>
      </div>

      <div>
        <%= person_fields.label :adresse %>
        <%= person_fields.text_field :adresse %>
      </div>

      <div>
        <%= person_fields.label :cp %>
        <%= person_fields.text_field :cp %>
      </div>

      <div>
        <%= person_fields.label :lieu %>
        <%= person_fields.text_field :lieu %>
      </div>

      <div>
        <%= person_fields.label :telephone %>
        <%= person_fields.text_field :telephone %>
      </div>

      <div>
        <%= person_fields.label :telephone_2 %>
        <%= person_fields.text_field :telephone_2 %>
      </div>

      <div>
        <%= person_fields.label :email %>
        <%= person_fields.text_field :email %>
      </div>

      <div>
        <%= person_fields.label :date_naissance %>
        <%= person_fields.date_field :date_naissance %>
      </div>

      <div>
        <%= person_fields.label :a_propos %>
        <%= person_fields.text_field :a_propos %>
      </div>
    <% end %>
 
    <!-- Student-specific fields -->
      <div>
        <%= form.label :niveau %>
        <%= form.text_field :niveau %>
      </div>

      <div>
        <%= form.label :source %>
        <%= form.text_field :source %>
      </div>

      <div>
        <%= form.label :date_premier_contact %>
        <%= form.date_field :date_premier_contact %>
      </div>

      <div>
        <%= form.label :date_inscription %>
        <%= form.date_field :date_inscription %>
      </div>

      <div>
        <%= form.label :date_fin %>
        <%= form.date_field :date_fin %>
      </div>

      <div>
        <%= form.label :statut %>
        <%= form.text_field :statut %>
      </div>

      <div>
        <%= form.label :style %>
        <%= form.text_field :style %>
      </div>

      <div>
        <%= form.label :instrument %>
        <%= form.text_field :instrument %>
      </div>
    
    <%= form.submit %>


  <% if student.errors.any? %>
  <div class="errors">
    <h2><%= pluralize(student.errors.count, "error") %></h2>
    <ul>
      <% student.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

    
<%end%>