<%= form_with model: student do |form| %>

    <!-- Person fields -->
    <%= form.fields_for :person do |person_fields| %>
      <div>
        <%= person_fields.label :title %>
        <%= person_fields.text_field :title %>
      </div>

      <div>
        <%= person_fields.label :greeting_formula %>
        <%= person_fields.text_field :greeting_formula %>
      </div>

      <div>
        <%= person_fields.label :use_tu, "Tutoiement (coché = tu, décoché = vous) " %>
        <%= person_fields.check_box :use_tu %>
      </div>

      <div>
        <%= person_fields.label :first_name %>
        <%= person_fields.text_field :first_name %>
      </div>

      <div>
        <%= person_fields.label :last_name %>
        <%= person_fields.text_field :last_name %>
      </div>

      <div>
        <%= person_fields.label :address %>
        <%= person_fields.text_field :address %>
      </div>

      <div>
        <%= person_fields.label :postal_code %>
        <%= person_fields.text_field :postal_code %>
      </div>

      <div>
        <%= person_fields.label :city %>
        <%= person_fields.text_field :city %>
      </div>

      <div>
        <%= person_fields.label :phone %>
        <%= person_fields.text_field :phone %>
      </div>

      <div>
        <%= person_fields.label :phone_2 %>
        <%= person_fields.text_field :phone_2 %>
      </div>

      <div>
        <%= person_fields.label :email %>
        <%= person_fields.text_field :email %>
      </div>

      <div>
        <%= person_fields.label :date_of_birth %>
        <%= person_fields.date_field :date_of_birth %>
      </div>

      <div>
        <%= person_fields.label :about_me %>
        <%= person_fields.text_field :about_me %>
      </div>
    <% end %>
 
    <!-- Student-specific fields -->
      <div>
        <%= form.label :level %>
        <%= form.text_field :level %>
      </div>

      <div>
        <%= form.label :source %>
        <%= form.text_field :source %>
      </div>

      <div>
        <%= form.label :first_contact_date %>
        <%= form.date_field :first_contact_date %>
      </div>

      <div>
        <%= form.label :enrollment_date %>
        <%= form.date_field :enrollment_date %>
      </div>

      <div>
        <%= form.label :end_date %>
        <%= form.date_field :end_date %>
      </div>

      <div>
        <%= form.label :status %>
        <%= form.text_field :status %>
      </div>

      <div>
        <%= form.label :style %>
        <%= form.text_field :style %>
      </div>

      <div>
        <%= form.label :instrument %>
        <%= form.text_field :instrument %>
      </div>
    
    <%= form.submit %>

<!-- for debugging -->
  <% if student.errors.any? %>
  <div class="errors">
    <h2><%= pluralize(student.errors.count, "error") %></h2>
    <ul>
      <% student.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<!-- for debugging -->

    
<%end%>