<h1><%= "#{@student.person.first_name} #{@student.person.last_name}" %></h1>

<p>
  <strong>Statut:</strong> 
  <span class="student-status student-status--<%= @student.status %>">
    <%= @student.status %>
  </span>
</p>

<%= link_to "Back", students_path %>
<br>
<%= link_to "Edit", edit_student_path(@student) %>
<br><br>
<%= button_to "Mark as ancien",
  student_path(@student),
  method: :patch,
  params: { student: { status: 'ancien' } },
  data: { turbo_confirm: "Mark this student as ancien? They will no longer appear in the active list." } %>
<br>
<div>
  <%= link_to "Voir échanges", student_interactions_path(@student) %>
</div>
