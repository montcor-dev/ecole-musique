<%# Determine the owner (student or teacher) for nested routing %>
<% owner = @student || @teacher %>

<%= form_with model: [owner, interaction], local: true do |form| %>
  <% if interaction.errors.any? %>
    <div>
      <h2><%= pluralize(interaction.errors.count, "error") %> prohibited this interaction from being saved:</h2>
      <ul>
        <% interaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :interaction_date %>
    <%= form.date_field :interaction_date %>
  </div>

  <div>
    <%= form.label :interaction_type %>
    <%= form.select :interaction_type, Interaction.interaction_types.keys.map { |k| [k.humanize, k] } %>
  </div>

  <div>
    <%= form.label :note %>
    <%= form.text_area :note %>
  </div>

  <div>
    <%= form.check_box :follow_up_needed %>
    <%= form.label :follow_up_needed %>
  </div>

  <div>
    <%= form.label :follow_up_due_date %>
    <%= form.date_field :follow_up_due_date %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>