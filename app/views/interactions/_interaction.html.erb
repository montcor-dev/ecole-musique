<div id="<%= dom_id interaction %>">
  <div>
    <strong>Date interaction:</strong>
    <%= interaction.date_interaction %>
  </div>

  <div>
    <strong>Student:</strong>
    <td><%= "#{interaction.student.prenom} #{interaction.student.nom}" %></td>
  </div>

  <div>
    <strong>Moyen:</strong>
    <%= interaction.moyen %>
  </div>

  <div>
    <strong>Note:</strong>
    <%= interaction.note %>
  </div>

  <div>
    <strong>Suivi necessaire:</strong>
    <%= interaction.suivi_necessaire %>
  </div>

  <div>
    <strong>Suivi delai:</strong>
    <%= interaction.suivi_delai %>
  </div>

  <div>
    <strong>Auteur:</strong>
    <%= interaction.auteur %>
  </div>

  <div>
    <strong>Interaction type:</strong>
    <%= interaction.interaction_type %>
  </div>

  <div>
    <strong>Annexes:</strong>
    <%= interaction.annexes %>
  </div>

</div>
