<h1>Interaction on <%= @interaction.interaction_date %></h1>

<p><strong>Person:</strong> <%= @interaction.person.full_name %></p>
<p><strong>Type:</strong> <%= @interaction.interaction_type.humanize %></p>
<p><strong>Note:</strong> <%= @interaction.note %></p>
<p><strong>Follow-up needed:</strong> <%= @interaction.follow_up_needed? ? "Yes" : "No" %></p>
<% if @interaction.follow_up_due_date %>
  <p><strong>Follow-up by:</strong> <%= @interaction.follow_up_due_date %></p>
<% end %>

<%= link_to "Edit", edit_interaction_path(@interaction) %>
<%= button_to "Delete", interaction_path(@interaction), method: :delete %>
<br>
<%= link_to "Back", polymorphic_path([@interaction.person.role_record, :interactions]) %>