<h1>Interactions<%= " for #{@person.full_name}" if @person %></h1>

<% if @owner %>
  <%= link_to "New Interaction", polymorphic_path([@owner, :interactions], action: :new) %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>Type</th>
      <th>Note</th>
      <th>Follow-up needed</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @interactions.each do |interaction| %>
      <tr>
        <td><%= interaction.interaction_date %></td>
        <td><%= interaction.interaction_type.humanize %></td>
        <td><%= truncate(interaction.note.to_s, length: 60) %></td>
        <td><%= interaction.follow_up_needed? ? "Yes" : "No" %></td>
        <td><%= link_to "View", interaction %></td>
      </tr>
    <% end %>
  </tbody>
</table>